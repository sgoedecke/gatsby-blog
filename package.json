{
  "name": "seangoedecke-blog",
  "private": true,
  "description": "Sean Goedecke's blog, built with Eleventy",
  "version": "0.1.0",
  "author": "Sean Goedecke",
  "license": "0BSD",
  "scripts": {
    "build": "eleventy",
    "develop": "eleventy --serve",
    "start": "npm run develop",
    "clean": "rm -rf public",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "update-popularity": "node update-popularity.js",
    "test": "node --test src/utils/*.test.js"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "fast-glob": "^3.3.3",
    "github-slugger": "^1.5.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "prismjs": "^1.20.0"
  },
  "devDependencies": {
    "prettier": "2.0.5",
    "remark-parse": "^6.0.3",
    "unified": "^8.4.2"
  }
}
